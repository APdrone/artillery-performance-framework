{
  "name": "artillery-fintech-performance-framework",
  "version": "2.1.0",
  "description": "Production-Grade FinTech End-to-End Performance, Load, Stress, and Chaos Resilience Framework powered by Artillery. Features OAuth2 JWT auth, Idempotency-Key deduplication, DB connection pool modeling, ETag optimistic locking, and real-time WebSocket ledger testing.",
  "main": "support/helper.js",
  "author": "Aman Patwal <amanpatwalfor@gmail.com> (https://github.com/APdrone)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/APdrone/artillery-e2e.git"
  },
  "keywords": [
    "artillery",
    "performance-testing",
    "load-testing",
    "stress-testing",
    "chaos-engineering",
    "idempotency",
    "websocket",
    "fintech",
    "banking",
    "sdet",
    "quality-engineering",
    "ci-cd",
    "sla-gates",
    "p99-latency"
  ],
  "scripts": {
    "start": "node support/mock-server.js",
    "mock:server": "node support/mock-server.js",
    "test": "node scripts/run-smoke-suite.js",
    "test:smoke": "node scripts/run-smoke-suite.js",
    "test:all": "npm run qa1:smoke",
    "test:e2e": "npx artillery run -e smoke --config ./config/qa1/end-to-end-banking-journey.yml ./scenarios/end-to-end-banking-journey.yml",
    "test:idempotency": "npx artillery run -e smoke --config ./config/qa1/idempotency-and-race-conditions.yml ./scenarios/idempotency-and-race-conditions.yml",
    "test:chaos": "npx artillery run -e smoke --config ./config/qa1/chaos-and-fault-tolerance.yml ./scenarios/chaos-and-fault-tolerance.yml",
    "test:ws": "npx artillery run -e smoke --config ./config/qa1/websocket-ledger-stream.yml ./scenarios/websocket-ledger-stream.yml",
    "seed": "node scripts/seed-data.js",
    "report:generate": "node scripts/generate-reports.js",
    "setup:configs": "node scripts/setup-configs.js",
    "qa1:smoke": "npm-run-all -s qa1:smoke:*",
    "qa1:load": "npm-run-all -s qa1:load:*",
    "qa1:stress": "npm-run-all -s qa1:stress:*",
    "dev1:smoke": "npm-run-all -s dev1:smoke:*",
    "dev1:load": "npm-run-all -s dev1:load:*",
    "dev1:stress": "npm-run-all -s dev1:stress:*",
    "uat:smoke": "npm-run-all -s uat:smoke:*",
    "uat:load": "npm-run-all -s uat:load:*",
    "uat:stress": "npm-run-all -s uat:stress:*",
    "qa1:smoke:e2e": "npx artillery run -e smoke --output ./report/qa1_smoke_end-to-end-banking-journey.json --config ./config/qa1/end-to-end-banking-journey.yml ./scenarios/end-to-end-banking-journey.yml",
    "qa1:smoke:idempotency": "npx artillery run -e smoke --output ./report/qa1_smoke_idempotency-and-race-conditions.json --config ./config/qa1/idempotency-and-race-conditions.yml ./scenarios/idempotency-and-race-conditions.yml",
    "qa1:smoke:chaos": "npx artillery run -e smoke --output ./report/qa1_smoke_chaos-and-fault-tolerance.json --config ./config/qa1/chaos-and-fault-tolerance.yml ./scenarios/chaos-and-fault-tolerance.yml",
    "qa1:smoke:ws": "npx artillery run -e smoke --output ./report/qa1_smoke_websocket-ledger-stream.json --config ./config/qa1/websocket-ledger-stream.yml ./scenarios/websocket-ledger-stream.yml",
    "qa1:smoke:profiles": "npx artillery run -e smoke --output ./report/qa1_smoke_profiles.json --config ./config/qa1/profiles.yml ./scenarios/profiles.yml",
    "qa1:smoke:creditCardUid": "npx artillery run -e smoke --output ./report/qa1_smoke_creditCardUid.json --config ./config/qa1/creditCardUid.yml ./scenarios/creditCardUid.yml",
    "qa1:smoke:activation-details": "npx artillery run -e smoke --output ./report/qa1_smoke_activation-details.json --config ./config/qa1/activation-details.yml ./scenarios/activation-details.yml",
    "qa1:smoke:transactions-total": "npx artillery run -e smoke --output ./report/qa1_smoke_transactions-total.json --config ./config/qa1/transactions-total.yml ./scenarios/transactions-total.yml",
    "qa1:smoke:close-eligibility": "npx artillery run -e smoke --output ./report/qa1_smoke_close-eligibility.json --config ./config/qa1/close-eligibility.yml ./scenarios/close-eligibility.yml",
    "qa1:smoke:post-conversion-statement": "npx artillery run -e smoke --output ./report/qa1_smoke_post-conversion-statement.json --config ./config/qa1/post-conversion-statement.yml ./scenarios/post-conversion-statement.yml",
    "qa1:smoke:get-phone-textability": "npx artillery run -e smoke --output ./report/qa1_smoke_get-phone-textability.json --config ./config/qa1/get-phone-textability.yml ./scenarios/get-phone-textability.yml",
    "qa1:smoke:closed-account-letters": "npx artillery run -e smoke --output ./report/qa1_smoke_closed-account-letters.json --config ./config/qa1/closed-account-letters.yml ./scenarios/closed-account-letters.yml",
    "qa1:smoke:pay-off-letter": "npx artillery run -e smoke --output ./report/qa1_smoke_pay-off-letter.json --config ./config/qa1/pay-off-letter.yml ./scenarios/pay-off-letter.yml",
    "qa1:smoke:rebok-eligibility": "npx artillery run -e smoke --output ./report/qa1_smoke_rebok-eligibility.json --config ./config/qa1/rebok-eligibility.yml ./scenarios/rebok-eligibility.yml",
    "qa1:smoke:get-settlement": "npx artillery run -e smoke --output ./report/qa1_smoke_get-settlement.json --config ./config/qa1/get-settlement.yml ./scenarios/get-settlement.yml"
  },
  "dependencies": {
    "artillery": "^2.0.22",
    "lodash": "^4.17.21",
    "randomstring": "^1.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
